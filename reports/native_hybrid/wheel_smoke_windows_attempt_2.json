                          "body":  "import hashlib\nimport json\nimport os\nimport platform\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\n\nimport anymesher\nfrom anymesher import native_cpp\nfrom anymesher.triangulation import (\n    constrained_planar_triangulation,\n    incircle as python_incircle,\n    orient2d as python_orient2d,\n)\n\norigin = Path(anymesher.__file__).resolve()\nprefix = Path(sys.prefix).resolve()\nassert os.path.commonpath((str(origin), str(prefix))) == str(prefix), (origin, prefix)\nassert anymesher.__version__ == \"0.2.1\"\nassert sys.flags.no_user_site == 1\nassert native_cpp.NATIVE_CPP_AVAILABLE\nassert native_cpp.compiled_native_boundary() is not None\n\npoints = np.array(\n    (\n        (0.0, 0.0),\n        (4.0, 0.0),\n        (4.0, 4.0),\n        (0.0, 4.0),\n        (1.0, 1.0),\n        (1.0, 3.0),\n        (3.0, 3.0),\n        (3.0, 1.0),\n    ),\n    dtype=np.float64,\n)\nfixture = {\n    \"outer\": (0, 1, 2, 3),\n    \"holes\": ((4, 5, 6, 7),),\n    \"constraints\": ((0, 4),),\n}\nauto_first = constrained_planar_triangulation(points, **fixture)\npython_result = constrained_planar_triangulation(points, backend=\"python\", **fixture)\nauto_second = constrained_planar_triangulation(points, backend=\"auto\", **fixture)\nnative_result = constrained_planar_triangulation(points, backend=\"native\", **fixture)\n\nassert (\n    auto_first.requested_backend,\n    auto_first.selected_backend,\n    auto_first.actual_backend,\n    auto_first.fallback_reason,\n) == (\"auto\", \"anymesher-cpp17\", \"anymesher-cpp17\", None)\nassert (\n    auto_second.requested_backend,\n    auto_second.selected_backend,\n    auto_second.actual_backend,\n    auto_second.fallback_reason,\n) == (\"auto\", \"anymesher-cpp17\", \"anymesher-cpp17\", None)\nassert (\n    native_result.requested_backend,\n    native_result.selected_backend,\n    native_result.actual_backend,\n    native_result.fallback_reason,\n) == (\"native\", \"anymesher-cpp17\", \"anymesher-cpp17\", None)\nassert (\n    python_result.requested_backend,\n    python_result.selected_backend,\n    python_result.actual_backend,\n    python_result.fallback_reason,\n) == (\"python\", \"python\", \"python\", None)\n\ndef canonical(result):\n    return {\n        \"points_hex\": [\n            [float(value).hex() for value in row]\n            for row in np.asarray(result.points, dtype=np.float64)\n        ],\n        \"triangles\": sorted(\n            tuple(sorted(int(value) for value in row))\n            for row in np.asarray(result.triangles, dtype=np.int64)\n        ),\n        \"segments\": sorted(\n            tuple(sorted(int(value) for value in row))\n            for row in np.asarray(result.segments, dtype=np.int64)\n        ),\n        \"boundary_segments\": sorted(\n            tuple(sorted(int(value) for value in row))\n            for row in np.asarray(result.boundary_segments, dtype=np.int64)\n        ),\n        \"mandatory_segments\": sorted(\n            tuple(sorted(int(value) for value in row))\n            for row in np.asarray(result.mandatory_segments, dtype=np.int64)\n        ),\n        \"outer_loop\": [int(value) for value in result.outer_loop],\n        \"hole_loops\": [\n            [int(value) for value in loop]\n            for loop in result.hole_loops\n        ],\n    }\n\ndef canonical_hash(result):\n    encoded = json.dumps(\n        canonical(result), sort_keys=True, separators=(\",\", \":\")\n    ).encode(\"utf-8\")\n    return hashlib.sha256(encoded).hexdigest()\n\ndef edge_counts(triangles):\n    counts = {}\n    for triangle in np.asarray(triangles, dtype=np.int64):\n        for first, second in (\n            (triangle[0], triangle[1]),\n            (triangle[1], triangle[2]),\n            (triangle[2], triangle[0]),\n        ):\n            edge = tuple(sorted((int(first), int(second))))\n            counts[edge] = counts.get(edge, 0) + 1\n    return counts\n\nresults = (auto_first, python_result, auto_second, native_result)\nfor result in results:\n    assert np.array_equal(result.points, points)\n    triangles = np.asarray(result.triangles, dtype=np.int64)\n    assert triangles.shape == (8, 3)\n    assert len({tuple(sorted(int(value) for value in row)) for row in triangles}) == 8\n    counts = edge_counts(triangles)\n    assert all(\n        counts[tuple(sorted(int(value) for value in edge))] == 1\n        for edge in np.asarray(result.boundary_segments, dtype=np.int64)\n    )\n    assert counts[(0, 4)] \u003e= 1\n    coordinates = result.points[triangles]\n    twice_area = (\n        (coordinates[:, 1, 0] - coordinates[:, 0, 0])\n        * (coordinates[:, 2, 1] - coordinates[:, 0, 1])\n        - (coordinates[:, 1, 1] - coordinates[:, 0, 1])\n        * (coordinates[:, 2, 0] - coordinates[:, 0, 0])\n    )\n    area = float(np.abs(twice_area).sum() * 0.5)\n    assert abs(area - 12.0) \u003c 1.0e-12\n    centroids = coordinates.mean(axis=1)\n    assert not np.any(\n        (centroids[:, 0] \u003e 1.0)\n        \u0026 (centroids[:, 0] \u003c 3.0)\n        \u0026 (centroids[:, 1] \u003e 1.0)\n        \u0026 (centroids[:, 1] \u003c 3.0)\n    )\n\nhashes = {\n    \"auto_first\": canonical_hash(auto_first),\n    \"python_oracle\": canonical_hash(python_result),\n    \"auto_second\": canonical_hash(auto_second),\n    \"strict_native\": canonical_hash(native_result),\n}\nassert len(set(hashes.values())) == 1\n\norientation_cases = (\n    (\"above\", (1.0, float(np.nextafter(1.0, np.inf))), 1),\n    (\"below\", (1.0, float(np.nextafter(1.0, -np.inf))), -1),\n)\ncircle = ((-1.0, 0.0), (1.0, 0.0), (0.0, 1.0))\nincircle_cases = (\n    (\"inside\", (0.0, float(np.nextafter(-1.0, np.inf))), 1),\n    (\"outside\", (0.0, float(np.nextafter(-1.0, -np.inf))), -1),\n    (\"boundary\", (0.0, -1.0), 0),\n)\npredicate_values = {\"orientation\": [], \"incircle\": []}\nfor label, point, expected_sign in orientation_cases:\n    native_value = float(native_cpp.orient2d((0.0, 0.0), (1.0, 1.0), point